<%- include('partials/header') %> 

<main>
  <%- include('partials/menu') %> 

  <section class="content">
    <h2>Gestión de Juegos</h2>

    <div class="form-container">
      <h3>Agregar Nuevo Juego</h3>
      <form action="/admin/juegos" method="POST">
        <input type="text" name="nombre" placeholder="Nombre del Juego" required>
        <input type="text" name="modo" placeholder="Modo (Ej: 5v5)" required>
        <input type="text" name="tipo" placeholder="Tipo (Ej: Shooter)" required>
        <button type="submit" class="btn btn-primary">Agregar</button>
      </form>
    </div>

    <div class="filters">
      <form id="search-form">
        <input type="text" id="search-input" placeholder="Buscar por nombre...">
        <button type="submit" class="btn btn-secondary">Buscar</button>
      </form>
    </div>

    <table id="juegos-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Modo</th>
          <th>Tipo</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (juegos && juegos.length > 0) { %>
          <% juegos.forEach(juego => { %>
            <tr>
              <td><%= juego.IDJuego %></td>
              <td><%= juego.Nombre %></td>
              <td><%= juego.Modo %></td>
              <td><%= juego.Tipo %></td>
              <td>
                <button class="btn btn-edit">Modificar</button>
                <button class="btn btn-delete">Baja</button>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
            <tr>
                <td colspan="5" style="text-align: center;">No hay juegos registrados.</td>
            </tr>
        <% } %>
      </tbody>
    </table>
  </section>
</main>

<%- include('partials/footer') %>