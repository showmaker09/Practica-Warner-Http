<%- include('partials/header') %>

<main>
  <%- include('partials/menu') %>

  <section class="content">
    <h2>Gestión de Usuarios</h2>

    <div class="form-container">
      <h3>Agregar Nuevo Usuario</h3>
      <form action="/admin/usuarios" method="POST">
        <input type="text" name="nombre" placeholder="Nombre del Usuario" required>
        <input type="text" name="correo" placeholder="Correo Electrónico" required>
        <input type="number" name="edad" placeholder="Edad" required>
        <button type="submit" class="btn btn-primary">Agregar</button>
      </form>
    </div>

    <div class="filters">
        <input type="text" id="search" placeholder="Buscar por nombre o correo...">
    </div>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Correo Electrónico</th>
          <th>Edad</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (usuarios && usuarios.length > 0) { %>
          <% usuarios.forEach(usuario => { %>
            <tr>
              <td><%= usuario.IDUsuario %></td>
              <td><%= usuario.Nombre %></td>
              <td><%= usuario.CorreoElectronico %></td>
              <td><%= usuario.Edad %></td>
              <td>
                <button class="btn btn-edit">Modificar</button>
                <button class="btn btn-delete">Baja</button>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
            <tr>
                <td colspan="5" style="text-align: center;">No hay usuarios registrados.</td>
            </tr>
        <% } %>
      </tbody>
    </table>
  </section>
</main>

<%- include('partials/footer') %>